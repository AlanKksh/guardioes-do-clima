<core:FragmentDefinition
    xmlns="sap.m"
    xmlns:core="sap.ui.core">

    <ToolbarSpacer id="toolbarSpacerLeft"/>

    <Label
        id="titleLugares"
        text="Lugares Populares:"
        design="Bold">
        <layoutData>
            <OverflowToolbarLayoutData id="layoutDataTitle" priority="High"/>
        </layoutData>
    </Label>

    <Button
        id="btnSaoPaulo"
        text="São Paulo 14°"
        type="Transparent"
        icon="sap-icon://building"
        press="onNavigateToSaoPaulo">
        <layoutData>
            <OverflowToolbarLayoutData id="layoutDataSaoPaulo" priority="Low"/>
        </layoutData>
    </Button>

    <Button
        id="btnRioGrandeDoSul"
        text="Rio Grande Do Sul 18°"
        type="Transparent"
        icon="sap-icon://building"
        press="onNavigateToRioGrandeDoSul">
        <layoutData>
            <OverflowToolbarLayoutData id="layoutDataRioGrandeDoSul" priority="Low"/>
        </layoutData>
    </Button>

    <Button
        id="btnRio"
        text="Rio de Janeiro 21°"
        type="Transparent"
        icon="sap-icon://building"
        press="onNavigateToRio">
        <layoutData>
            <OverflowToolbarLayoutData id="layoutDataRio" priority="Low"/>
        </layoutData>
    </Button>

    <Button
        id="btnBrasilia"
        text="Brasília 15°"
        type="Transparent"
        icon="sap-icon://building"
        press="onNavigateToBrasilia">
        <layoutData>
            <OverflowToolbarLayoutData id="layoutDataBrasilia" priority="Low"/>
        </layoutData>
    </Button>

    <Button
        id="btnSalvador"
        text="Salvador 25°"
        type="Transparent"
        icon="sap-icon://building"
        press="onNavigateToSalvador">
        <layoutData>
            <OverflowToolbarLayoutData id="layoutDataSalvador" priority="Low"/>
        </layoutData>
    </Button>

    <ToolbarSeparator id="toolbarSeparator">
        <layoutData>
            <OverflowToolbarLayoutData id="layoutDataSeparator" priority="Low"/>
        </layoutData>
    </ToolbarSeparator>

    <Input
        id="cityInput"
        width="9rem"
        placeholder="Digite uma cidade..."
        submit="onButtonPress">
        <layoutData>
            <OverflowToolbarLayoutData id="layoutDataInput" priority="NeverOverflow"/>
        </layoutData>
    </Input>

    <Button
        id="btnBuscar"
        icon="sap-icon://search"
        text="Buscar"
        type="Ghost"
        press="onButtonPress">
        <layoutData>
            <OverflowToolbarLayoutData id="layoutDataBtnBuscar" priority="NeverOverflow"/>
        </layoutData>
    </Button>

</core:FragmentDefinition>
